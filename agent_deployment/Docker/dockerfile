# Use official Python image
FROM python:3.11-slim

# Set work directory
WORKDIR /app

# Copy code and templates
COPY app.py deploy-agent-AWS-AMI.yml ./
COPY templates ./templates

# Install dependencies
RUN pip install --no-cache-dir flask boto3 redis python-dotenv

# Expose port
EXPOSE 5000

# Set environment variables as needed (or pass via docker run -e ...)
# ENV AWS_ACCESS_KEY=your_access AWS_SECRET_KEY=your_secret ...

# Entrypoint
CMD ["python", "app.py"]