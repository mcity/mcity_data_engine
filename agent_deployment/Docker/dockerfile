FROM python:3.11-slim

WORKDIR /app

# App.py imports config.py, redisManager.py, cloudFormationManager.py, and reads
# the CFN template directly, so all need to be present alongside it.
COPY App.py config.py redisManager.py cloudFormationManager.py deploy-agent-AWS-AMI.yml ./
COPY templates ./templates

RUN pip install --no-cache-dir flask boto3 redis python-dotenv

EXPOSE 5000

CMD ["python", "App.py"]